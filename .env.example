# McBuddy AI 环境变量示例
# 复制为 .env 即可使用；start.bat / start.sh 会在缺少 .env 时自动复制。
#
# 默认值全部指向 Demo Mode：零 Token、零 API Key、零外部服务依赖。

# 运行模式：demo（本地演示）| live（真实 LLM）| full（真实 LLM + 真实 MCP）
MCBUDDY_MODE=demo

# LLM 提供方：replay（规则引擎回放，默认）| deepseek | openai
MCBUDDY_LLM=replay

# MCP 数据源：fixture（本地脱敏快照，默认）| live（真实调用麦当劳 MCP）
MCBUDDY_MCP=fixture

# SQLite 数据库路径（相对项目根目录）
DATABASE_PATH=database/mcbuddy.db

# ---------------------------------------------------------------------------
# 以下变量仅在接入真实服务时才需要填写，留空即保持 Demo Mode。
# 切勿把真实凭证提交到仓库（.gitignore 已排除 .env）。
# ---------------------------------------------------------------------------

# 麦当劳 MCP Token，申请地址：https://open.mcd.cn/mcp
# 🔒 真实 Token 只能写在这个 .env 里；本文件会提交到仓库，请勿填入真实值。
# 留空或保持占位值即自动使用本地演示数据。
# MCD_MCP_TOKEN=

# MCP 服务地址（通常无需修改）
MCP_BASE_URL=https://mcp.mcd.cn

# 真实 LLM 的 API Key（当 MCBUDDY_LLM 不是 replay 时需要）
# LLM_API_KEY=
